# ==============================================================================
# VARIABLES DE ENTORNO - BACKEND GUIASALUD V1.0
# ==============================================================================

# Entorno y Puerto del Servidor
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Conexión Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=guiasalud_db
DB_USER=postgres
DB_PASSWORD=postgres_password_123
DB_SSL=false

# Autenticación y Criptografía (JWT & 2FA)
JWT_SECRET=super_secret_jwt_key_guiasalud_2026_change_in_production
JWT_EXPIRES_IN=24h
JWT_2FA_SECRET=temp_secret_2fa_verification_key

# Cifrado en Reposo de Historia Clínica (AES-256-GCM)
# La clave debe ser una cadena hexadecimal de 64 caracteres (32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Configuración CORS
CORS_ORIGIN=http://localhost:8443,http://localhost:5173,http://localhost:3000,http://localhost:8081

# Logs y Auditoría de Seguridad (Directrices OMS)
AUDIT_LOG_FILE=./logs/audit_security.log
